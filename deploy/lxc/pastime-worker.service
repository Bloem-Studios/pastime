[Unit]
Description=Pastime background worker
After=pastime.service
Requires=docker.service

[Service]
User=pastime
EnvironmentFile=/etc/pastime/pastime.env
ExecStart=/usr/local/bin/pastime worker
TimeoutStopSec=90
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
